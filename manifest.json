{
  "manifest_version": 3,
  "name": "Metabuscadores CVC",
  "version": "0.17.0",
  "description": "Analisa a busca que VOCE fez a mao no Skyscanner ou no Kayak: voos CVC por companhia, posicoes e tempo de cada fonte no log do ConectaAS. Sem servidor local.",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*.k8s-cvc.com.br/*",
    "https://*.cvc.com.br/*"
  ],
  "host_permissions": [
    "https://api-java-soap-partnership.k8s-cvc.com.br/*",
    "https://www.kayak.com.br/*",
    "https://kayak.com.br/*",
    "https://www.skyscanner.com.br/*",
    "https://www.skyscanner.net/*"
  ],
  "background": {
    "service_worker": "servico.js"
  },
  "action": {
    "default_title": "Metabuscadores CVC — abre o painel",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png",
      "48": "icones/icone48.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.skyscanner.com.br/*",
        "https://www.skyscanner.net/*",
        "https://www.kayak.com.br/*",
        "https://kayak.com.br/*"
      ],
      "js": [
        "gancho.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.skyscanner.com.br/*",
        "https://www.skyscanner.net/*",
        "https://www.kayak.com.br/*",
        "https://kayak.com.br/*"
      ],
      "js": [
        "analise.js",
        "historico.js",
        "coletor.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
